# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 개인 여행 데이터가 들어있는 로컬 SQLite DB — 절대 커밋하지 않는다
/prisma/dev.db
/prisma/*.db
/prisma/*.db-journal

# 콘텐츠 수집 큐 상태 (재생성 가능한 작업 상태일 뿐, 커밋 불필요)
/scripts/queue.db
/scripts/queue.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts
